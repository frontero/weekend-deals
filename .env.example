# Copy to .env.local and fill in to show Google ratings per park,
# or run scripts/setup-google-key.sh, which walks through it and fills it in.
# Needs a Google Cloud project with "Places API (New)" enabled and a billing account.
# The app looks up each park at most once per 30 days and stops at 900 lookups a month
# (Google gives 1,000 rating lookups free per month).
GOOGLE_PLACES_API_KEY=

# Affiliate deep links per provider, as JSON, with {url} where the provider's page goes (server/affiliate.mjs).
# The cloud app reads the same value from its AFFILIATE_LINKS setting. Without it, links go to the providers directly.
# AFFILIATE_LINKS={"landal":"https://affiliate-network.example/c/?si=…&dl={url}"}
