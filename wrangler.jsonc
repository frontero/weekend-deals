// The app in the cloud as a Cloudflare Worker (free plan). Deploy with `npm run cloud:deploy`; first-time setup,
// secrets and Cloudflare Access: scripts/setup-cloudflare.sh.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weekend-deals",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The API, and the park and weekend pages with their sitemap (server/pages.mjs).
    "run_worker_first": ["/api/*", "/park/*", "/parken", "/weekend/*", "/weekenden", "/sitemap.xml", "/robots.txt"]
  },
  "workers_dev": true,
  // The clock that starts the price rounds and the price watch on GitHub (worker/clock.mjs). Its token is the secret
  // GITHUB_DISPATCH_TOKEN.
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": { "GITHUB_REPOSITORY": "frontero/weekend-deals" },
  // Preview addresses per upload would sit outside Cloudflare Access.
  "preview_urls": false,
  "observability": { "enabled": true }
}
