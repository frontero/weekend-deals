// The app in the cloud as a Cloudflare Worker (free plan). Deploy with `npm run cloud:deploy`; first-time setup,
// secrets and Cloudflare Access: scripts/setup-cloudflare.sh.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weekend-deals",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The API, and the park, weekend, region and theme pages with their sitemap (server/pages.mjs).
    "run_worker_first": ["/api/*", "/park/*", "/parken", "/weekend/*", "/weekenden", "/regio/*", "/thema/*", "/land/*", "/last-minute", "/privacy", "/sitemap.xml", "/robots.txt"]
  },
  // Per visitor, the calls that cost something (live prices, Google reviews, address lookups, alerts): see worker/index.mjs.
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  "workers_dev": true,
  // The clock that starts the price rounds and the price watch on GitHub (worker/clock.mjs). Its token is the secret
  // GITHUB_DISPATCH_TOKEN.
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": { "GITHUB_REPOSITORY": "frontero/weekend-deals" },
  // Preview addresses per upload would be copies of the site that search engines could find.
  "preview_urls": false,
  "observability": { "enabled": true }
}
