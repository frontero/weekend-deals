// The app in the cloud as a Cloudflare Worker (free plan). Deploy with `npm run cloud:deploy`; first-time setup,
// secrets and Cloudflare Access: scripts/setup-cloudflare.sh.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weekend-deals",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // An address without a file comes to the Worker, which serves the app under /beheer and a real 404 elsewhere:
    // with "single-page-application" every mistyped address showed the search page as if it existed.
    "not_found_handling": "none",
    // The API, and the park, weekend, region and theme pages with their sitemap (server/pages.mjs).
    "run_worker_first": ["/api/*", "/park/*", "/parken", "/weekend/*", "/weekenden", "/regio/*", "/thema/*", "/land/*", "/feestdag/*", "/vakantie/*", "/last-minute", "/privacy", "/zo-werkt-het", "/sitemap.xml", "/robots.txt"]
  },
  // Per visitor, the calls that cost something (live prices, Google reviews, address lookups, alerts): see worker/index.mjs.
  // The visit counts (server/events.mjs) come in batches every few seconds, with a limit of their own.
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "EVENT_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  // Anonymous visit counts, read back on the admin's Bezoekers page with the secret ANALYTICS_READ_TOKEN (a Cloudflare
  // API token with only Account Analytics Read) on the account below.
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "parkjeweg_events" }],
  // Only the site's own address: a workers.dev copy would be a second entrance and duplicate content for search engines.
  // www.parkjeweg.nl goes to the bare domain through a redirect rule in the Cloudflare zone.
  "workers_dev": false,
  "routes": [{ "pattern": "parkjeweg.nl", "custom_domain": true }],
  // The clock that starts the price rounds and the price watch on GitHub (worker/clock.mjs). Its token is the secret
  // GITHUB_DISPATCH_TOKEN.
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": { "GITHUB_REPOSITORY": "frontero/weekend-deals", "CLOUDFLARE_ACCOUNT_ID": "d389fd8feb9ce2879148841b958456ce" },
  // Preview addresses per upload would be copies of the site that search engines could find.
  "preview_urls": false,
  "observability": { "enabled": true }
}
