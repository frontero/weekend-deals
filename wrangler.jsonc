// The app in the cloud as a Cloudflare Worker (free plan). Deploy with `npm run cloud:deploy`; first-time setup,
// secrets and Cloudflare Access: scripts/setup-cloudflare.sh.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weekend-deals",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "workers_dev": true,
  // Preview addresses per upload would sit outside Cloudflare Access.
  "preview_urls": false,
  "observability": { "enabled": true }
}
